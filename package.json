{
  "name": "matiq-voice",
  "productName": "MatiQ Voice",
  "version": "0.2.1",
  "private": true,
  "description": "Private English dictation and meeting notes by MatiQ.",
  "author": "MatiQ Inc",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "test:desktop": "node scripts/e2e.mjs",
    "engine:build": "node scripts/build-engine.mjs",
    "package": "electron-builder --publish never",
    "package:dir": "electron-builder --dir --publish never",
    "test:e2e": "node scripts/e2e.mjs",
    "oauth:configure": "node scripts/configure-oauth.cjs",
    "package:release": "node scripts/release.cjs",
    "test:focus": "node scripts/e2e-focus.mjs",
    "test:packaged": "node scripts/e2e-packaged.mjs"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "playwright": "1.64.1"
  },
  "build": {
    "appId": "com.matiq.voice",
    "asar": true,
    "files": [
      "src/**/*",
      "package.json",
      "config/oauth.json"
    ],
    "extraResources": [
      {
        "from": "engine",
        "to": "engine"
      },
      {
        "from": "native/windows-input.ps1",
        "to": "native/windows-input.ps1"
      }
    ],
    "beforePack": "./scripts/check-package.cjs",
    "directories": {
      "output": "dist"
    },
    "mac": {
      "minimumSystemVersion": "14.2",
      "identity": "-",
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "entitlements": "native/entitlements.mac.plist",
      "entitlementsInherit": "native/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "MatiQ Voice records speech when you start dictation or a meeting. Recognition runs on this device.",
        "NSAudioCaptureUsageDescription": "MatiQ Voice captures meeting audio from this computer only when you start meeting recording.",
        "NSScreenCaptureUsageDescription": "Choose the meeting screen to capture its audio. MatiQ Voice does not save screen video."
      }
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "asarUnpack": [
      "node_modules/**/*.node",
      "node_modules/**/*.dylib",
      "node_modules/**/*.dll",
      "node_modules/**/*.so*"
    ],
    "icon": "src/ui/assets/app-icon.png"
  },
  "dependencies": {
    "sherpa-onnx-node": "2.0.0"
  }
}
