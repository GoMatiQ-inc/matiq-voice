{
  "name": "verbatim-dictation",
  "productName": "Verbatim",
  "version": "0.1.0",
  "private": true,
  "description": "Local dictation for macOS and Windows, without rewriting.",
  "author": "Verbatim contributors",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "test:desktop": "node scripts/smoke-desktop.mjs",
    "engine:build": "node scripts/build-engine.mjs",
    "package": "electron-builder --publish never",
    "package:dir": "electron-builder --dir --publish never"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "playwright": "1.64.1"
  },
  "build": {
    "appId": "app.verbatim.dictation",
    "asar": true,
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "engine",
        "to": "engine"
      },
      {
        "from": "native/windows-input.ps1",
        "to": "native/windows-input.ps1"
      }
    ],
    "beforePack": "./scripts/check-package.cjs",
    "directories": {
      "output": "dist"
    },
    "mac": {
      "minimumSystemVersion": "14.0",
      "identity": "-",
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "entitlements": "native/entitlements.mac.plist",
      "entitlementsInherit": "native/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Verbatim records your voice only when you start dictation. Speech recognition runs on this Mac."
      }
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
